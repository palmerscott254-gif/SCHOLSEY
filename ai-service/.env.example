# Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# AI/ML Models
MODEL_PATH=/models
MODEL_CACHE_DIR=/tmp/model_cache

# AI Detection APIs (if using external services)
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/scholsey

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Service
BACKEND_SERVICE_URL=http://localhost:3000

# Analysis Settings
CONFIDENCE_THRESHOLD=0.7
MAX_FILE_SIZE_MB=10
SUPPORTED_FILE_TYPES=.pdf,.doc,.docx,.txt

# Logging
LOG_LEVEL=INFO
