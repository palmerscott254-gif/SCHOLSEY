{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src/main",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "skipLibCheck": true,
    "typeRoots": [],
    "types": []
  },
  "include": ["src/main/**/*.ts"],
  "exclude": ["node_modules"]
}
