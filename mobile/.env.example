# API Configuration
API_URL=http://YOUR_DEV_HOST:3000/v1
WS_URL=ws://YOUR_DEV_HOST:3000/ws

# Environment
NODE_ENV=development

# App Configuration
APP_NAME=Scholsey
APP_VERSION=1.0.0

# Example hosts:
# Android emulator: 10.0.2.2
# iOS simulator: localhost
# Physical device: your machine's LAN IP

# Location Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Push Notifications
EXPO_PUSH_TOKEN=your-expo-push-token
